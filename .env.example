# Copy to .env.local and fill in. Never commit real keys.
# Set a spending cap on every provider key (design doc §11, §13a).

# LiveKit Cloud project (Build plan): Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT: Deepgram
DEEPGRAM_API_KEY=

# LLM: Gemini (Google AI Studio key)
GOOGLE_API_KEY=

# TTS: Cartesia
CARTESIA_API_KEY=
# Optional: a Hindi/Hinglish voice id from the Cartesia voice library; plugin default if empty
CARTESIA_VOICE_ID=
