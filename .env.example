# Copy to .env and fill in. Never commit real keys.
# Set a spending cap on every provider key (design doc §11, §13a).

# LiveKit Cloud project (Build plan): Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Language for every stage at once: en | hinglish. English while the engineering is built;
# Hinglish audio returns in week 4. Label every latency run with this value.
AGENT_LANGUAGE=en

# Providers are chosen here so comparisons need no code change.
STT_PROVIDER=deepgram          # deepgram | sarvam
TTS_PROVIDER=cartesia          # cartesia | sarvam
TURN_DETECTOR=v1-mini          # v1-mini (local, text) | v1 (LiveKit cloud, hears audio)
# E9: give STT this clinic's doctor names as keyterms (Deepgram nova-3). off until measured.
STT_KEYTERMS=off

# STT: Deepgram
DEEPGRAM_API_KEY=

# STT + TTS: Sarvam (dashboard.sarvam.ai)
SARVAM_API_KEY=
# Optional Bulbul v3 voice; "simran" if empty. Compare voices with scripts/tts_samples.py
SARVAM_SPEAKER=

# LLM: provider and model are config, so experiments swap models without code changes.
# Only "gemini" is wired up so far; the other keys are placeholders for model comparisons.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# TTS: Cartesia
CARTESIA_API_KEY=
# Optional: a Hindi/Hinglish voice id from the Cartesia voice library; plugin default if empty
CARTESIA_VOICE_ID=

# Database: Supabase Postgres connection string (Project Settings -> Database -> Connection
# string -> "Session pooler"). Optional: without it, turns are only written to logs/turns.jsonl.
DATABASE_URL=

# Evals: a SEPARATE database (second Supabase project or local Postgres). Evals refuse to run
# without it and refuse to run against DATABASE_URL (design §16.2: evals never touch real data).
EVAL_DATABASE_URL=

# Re-engage a silent caller after 8 s, twice, then end the call politely (agent/silence.py)
SILENCE_REPROMPT=on
